# Copy this to .env for local dev, or set these as Environment Variables in
# your hosting provider's dashboard (e.g. Vercel: Project → Settings →
# Environment Variables) for production.

# PostgreSQL connection string. For a hosted provider (Neon, Supabase, etc.)
# this is given to you after creating the database — paste it here verbatim,
# including ?sslmode=require if the provider includes it.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random secret used to sign session cookies. Generate a fresh one for
# production — never reuse the dev value below. Example way to generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-secret-change-in-production-please-do-not-ship-this-value-xyz123

# SMS gateway for OTP delivery. Leave both blank to run in dev mode, where
# OTP codes are printed to the server console log instead of being sent —
# useful for testing, but real users will never receive a real SMS. Set both
# once a provider account exists (e.g. MSG91, 2Factor.in — see src/lib/sms.ts
# for where the real integration goes).
SMS_PROVIDER=
SMS_API_KEY=
